// Rotorua Visitor Growth & Flow Intelligence — data model
// See docs/ARCHITECTURE.md §1-2 for the design rationale.
//
// Governance rule enforced by this schema: every observation / derived-
// intelligence row carries source, dataType, timestamp, geography, time
// period, confidence and access level. There is no fact table without them.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// DATABASE_URL: runtime connection. On Supabase + Vercel use the pooled
//   (Supavisor transaction mode, port 6543) URL with ?pgbouncer=true&connection_limit=1.
// DIRECT_URL: direct/session connection (port 5432) used by `prisma migrate`.
//   Locally and in CI it can be the same value as DATABASE_URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Governance enums
// ---------------------------------------------------------------------------

enum AccessLevel {
  PUBLIC // openly published data (e.g. Stats NZ, RotoruaNZ public reports)
  PARTNER // shared with the DMO / destination-management partners
  PRIVATE_BUSINESS // a single business's own data — never shown to competitors
  AGGREGATED // rolled up from private data such that no single business is identifiable
  MODEL_INFERENCE // generated by an engine, not observed directly
}

enum Confidence {
  VERIFIED // primary source, directly reported
  HIGH // reputable secondary source or well-sampled survey
  MEDIUM // partial coverage, small sample, or dated
  LOW // indicative only
  MODELLED // derived/inferred by an engine — never upgraded to VERIFIED
}

enum Role {
  PUBLIC
  PARTNER
  BUSINESS
  ADMIN
}

enum ConnectorStatus {
  CONNECTED
  NOT_CONNECTED
  MANUAL_IMPORT_ONLY
  ERROR
}

// ---------------------------------------------------------------------------
// Reference: destinations (scalability — Rotorua is the first, not the only)
// ---------------------------------------------------------------------------

model Destination {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "rotorua"
  name      String
  country   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  dataSources             DataSource[]
  visitorMetrics          VisitorMetric[]
  accommodationMetrics    AccommodationMetric[]
  accommodationProperties AccommodationProperty[]
  experiences             Experience[]
  demandSignals           DemandSignal[]
  weatherObservations     WeatherObservation[]
  weatherForecasts        WeatherForecast[]
  publicHolidays          PublicHoliday[]
  transportDisruptions    TransportDisruption[]
  capacityRecords         CapacityRecord[]
  trackedPrompts          TrackedPrompt[]
  aiVisibilityChecks      AIVisibilityCheck[]
  destinationEvents       DestinationEvent[]
  businesses              Business[]
  marketOpportunities     MarketOpportunity[]
  productGaps             ProductGap[]
  partnerships            Partnership[]
  campaigns               Campaign[]
  itineraries             Itinerary[]
  scenarioQueries         ScenarioQuery[]
  importBatches           ImportBatch[]
}

// ---------------------------------------------------------------------------
// Governance registry
// ---------------------------------------------------------------------------

model DataSource {
  id                 String          @id @default(cuid())
  destinationId      String
  destination        Destination     @relation(fields: [destinationId], references: [id])
  name               String // e.g. "RotoruaNZ Visitor Spend Report", "Open-Meteo"
  organisation       String // who publishes/owns it
  dataType           String // e.g. "visitor spend", "weather forecast"
  licence            String? // usage terms, if known
  defaultAccessLevel AccessLevel     @default(PUBLIC)
  connectorStatus    ConnectorStatus @default(MANUAL_IMPORT_ONLY)
  connectorKey       String? // internal key of the connector module, if CONNECTED
  url                String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  importBatches        ImportBatch[]
  visitorMetrics       VisitorMetric[]
  accommodationMetrics AccommodationMetric[]
  experiences          Experience[]
  demandSignals        DemandSignal[]
  weatherObservations  WeatherObservation[]
  weatherForecasts     WeatherForecast[]
  publicHolidays       PublicHoliday[]
  transportDisruptions TransportDisruption[]
  capacityRecords      CapacityRecord[]
  aiVisibilityChecks   AIVisibilityCheck[]
  destinationEvents    DestinationEvent[]

  @@unique([destinationId, name])
}

// Every manual CSV upload — the audit trail behind manual-import data.
model ImportBatch {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  dataSourceId  String
  dataSource    DataSource  @relation(fields: [dataSourceId], references: [id])
  targetTable   String // which observation table this batch loaded
  uploadedBy    String // email/id of the operator who imported it
  fileName      String
  rowCount      Int
  rejectedCount Int         @default(0)
  geography     String
  periodStart   DateTime
  periodEnd     DateTime
  confidence    Confidence
  accessLevel   AccessLevel
  notes         String?
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// VISITORS
// ---------------------------------------------------------------------------

model VisitorMetric {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  metric String // e.g. "visitor_volume", "avg_length_of_stay_nights", "total_spend_nzd"
  value  Float
  unit   String // e.g. "count", "nights", "nzd"

  originMarket    String? // e.g. "Australia", "Domestic - Auckland", null = all markets
  isInternational Boolean?
  visitorPurpose  String? // e.g. "leisure", "business", "VFR"

  geography   String // e.g. "Rotorua District"
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, metric, periodStart])
}

// ---------------------------------------------------------------------------
// ACCOMMODATION
// ---------------------------------------------------------------------------

model AccommodationProperty {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  type          String // e.g. "hotel", "motel", "holiday_park", "Airbnb"
  geography     String
  roomCount     Int?
  businessId    String?
  business      Business?   @relation(fields: [businessId], references: [id])
  createdAt     DateTime    @default(now())

  metrics AccommodationMetric[]
}

model AccommodationMetric {
  id            String                 @id @default(cuid())
  destinationId String
  destination   Destination            @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource             @relation(fields: [sourceId], references: [id])
  propertyId    String?
  property      AccommodationProperty? @relation(fields: [propertyId], references: [id])

  metric String // e.g. "occupancy_rate", "room_nights_sold", "forward_bookings"
  value  Float
  unit   String

  accommodationType String? // used when propertyId is null (aggregated by type)
  geography         String
  periodStart       DateTime
  periodEnd         DateTime
  confidence        Confidence
  accessLevel       AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, metric, periodStart])
}

// ---------------------------------------------------------------------------
// EXPERIENCES
// ---------------------------------------------------------------------------

model ExperienceCategory {
  id          String       @id @default(cuid())
  slug        String       @unique // e.g. "geothermal", "maori-culture", "adventure"
  name        String
  description String?
  experiences Experience[]
}

model Experience {
  id            String             @id @default(cuid())
  destinationId String
  destination   Destination        @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource         @relation(fields: [sourceId], references: [id])
  categoryId    String
  category      ExperienceCategory @relation(fields: [categoryId], references: [id])
  businessId    String?
  business      Business?          @relation(fields: [businessId], references: [id])

  name        String
  description String?
  geography   String
  isBookable  Boolean @default(false)
  websiteUrl  String?

  accessLevel AccessLevel @default(PUBLIC)
  confidence  Confidence  @default(VERIFIED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  capacityRecords CapacityRecord[]

  @@index([destinationId, categoryId])
}

// ---------------------------------------------------------------------------
// DEMAND
// ---------------------------------------------------------------------------

model DemandSignal {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  signalType String // e.g. "search_trend", "ai_travel_query", "social_mention", "booking_lead"
  topic      String // e.g. "geothermal spa", "mountain biking Rotorua"
  value      Float // index/volume score as reported by the source — never invented
  unit       String

  geography   String // origin market geography, or "global"
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, signalType, periodStart])
}

// ---------------------------------------------------------------------------
// AI DESTINATION DISCOVERY ENGINE
// ---------------------------------------------------------------------------

model TrackedPrompt {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  prompt        String // e.g. "Best things to do in Rotorua"
  category      String // e.g. "general", "cultural", "adventure", "wellness", "itinerary"
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  checks AIVisibilityCheck[]
}

model AIVisibilityCheck {
  id            String        @id @default(cuid())
  destinationId String
  destination   Destination   @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource    @relation(fields: [sourceId], references: [id])
  promptId      String
  prompt        TrackedPrompt @relation(fields: [promptId], references: [id])

  aiSystem               String // e.g. "claude-sonnet-5", "gpt-4o" — whatever was actually called
  rawResponse            String // full response text, for audit
  destinationMentioned   Boolean
  mentionPosition        Int? // 1 = first recommendation mentioned, null if not mentioned
  experiencesRecommended String[] // extracted experience names, as the model stated them
  competitorsMentioned   String[]
  citedSources           String[]
  factualIssues          String[] // anything the reviewer flags as incorrect — populated by a human review pass, not invented

  confidence  Confidence  @default(MODELLED)
  accessLevel AccessLevel @default(PARTNER)

  runAt     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([destinationId, promptId, runAt])
}

// ---------------------------------------------------------------------------
// CONDITIONS
// ---------------------------------------------------------------------------

model WeatherObservation {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  temperatureC    Float
  conditionCode   String // provider's own weather code, stored as-is
  windSpeedKmh    Float?
  precipitationMm Float?

  geography   String
  observedAt  DateTime
  confidence  Confidence  @default(VERIFIED)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, observedAt])
}

model WeatherForecast {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  forDate                  DateTime
  temperatureMinC          Float
  temperatureMaxC          Float
  conditionCode            String
  precipitationProbability Float?

  geography   String
  issuedAt    DateTime
  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, forDate])
}

model PublicHoliday {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  name              String
  date              DateTime
  regional          Boolean  @default(false)
  countiesOrRegions String[]

  accessLevel AccessLevel @default(PUBLIC)
  confidence  Confidence  @default(VERIFIED)
  createdAt   DateTime    @default(now())

  @@index([destinationId, date])
}

model TransportDisruption {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  mode        String // e.g. "road", "air", "rail"
  description String
  geography   String
  startsAt    DateTime
  endsAt      DateTime?

  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// CAPACITY
// ---------------------------------------------------------------------------

model CapacityRecord {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])
  experienceId  String?
  experience    Experience? @relation(fields: [experienceId], references: [id])

  capacityType      String // "attraction" | "accommodation" | "transport" | "event"
  totalCapacity     Float?
  availableCapacity Float?
  unit              String // e.g. "visitors/day", "rooms", "seats"
  verifiedAvailable Boolean @default(false) // must be true before an engine may present this as currently bookable

  geography   String
  periodStart DateTime
  periodEnd   DateTime
  confidence  Confidence
  accessLevel AccessLevel

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([destinationId, capacityType, periodStart])
}

// ---------------------------------------------------------------------------
// EVENTS
// ---------------------------------------------------------------------------

model DestinationEvent {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  sourceId      String
  source        DataSource  @relation(fields: [sourceId], references: [id])

  name               String
  category           String // e.g. "festival", "sport", "conference", "cultural"
  geography          String
  startsAt           DateTime
  endsAt             DateTime
  expectedAttendance Int?

  confidence  Confidence  @default(HIGH)
  accessLevel AccessLevel @default(PUBLIC)
  createdAt   DateTime    @default(now())

  @@index([destinationId, startsAt])
}

// ---------------------------------------------------------------------------
// BUSINESS ECOSYSTEM
// ---------------------------------------------------------------------------

model Business {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  name          String
  category      String
  contactEmail  String?
  createdAt     DateTime    @default(now())

  experiences             Experience[]
  accommodationProperties AccommodationProperty[]
  contributions           BusinessContribution[]
}

// Anything a business opts to share (capacity, offers, new products) — always
// PRIVATE_BUSINESS unless the business explicitly marks it for aggregation.
model BusinessContribution {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  contributionType String // "capacity" | "new_product" | "event" | "offer" | "availability"
  payload          Json // shape depends on contributionType — validated at the API layer
  accessLevel      AccessLevel @default(PRIVATE_BUSINESS)

  submittedBy String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// DERIVED INTELLIGENCE — every row must cite the evidence it used and, where
// evidence is incomplete, what's still needed (dataNeeded).
// ---------------------------------------------------------------------------

model MarketOpportunity {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  market             String
  travellerType      String
  demandSignal       String
  currentPerformance String
  competition        String
  productFit         String
  gap                String
  potential          String
  risks              String
  dataNeeded         String[]

  evidenceRefs Json // { visitorMetricIds: [...], demandSignalIds: [...] }
  confidence   Confidence  @default(MODELLED)
  accessLevel  AccessLevel @default(PARTNER)
  createdAt    DateTime    @default(now())
}

model ProductGap {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  targetVisitor            String
  demandSignal             String
  currentSupply            String
  gap                      String
  potentialProduct         String
  potentialPartners        String[]
  seasonality              String
  competition              String
  commercialConsiderations String
  risks                    String
  dataNeeded               String[]

  evidenceRefs Json
  confidence   Confidence  @default(MODELLED)
  accessLevel  AccessLevel @default(PARTNER)
  createdAt    DateTime    @default(now())
}

model Partnership {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  name          String
  participants  String[]
  rationale     String
  targetOutcome String // e.g. "longer stays", "off-season demand"
  evidenceRefs  Json
  confidence    Confidence  @default(MODELLED)
  accessLevel   AccessLevel @default(PARTNER)
  createdAt     DateTime    @default(now())
}

model Itinerary {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  title         String
  visitorType   String
  nights        Int
  interests     String[]
  itineraryJson Json // day-by-day plan referencing only verified, bookable Experience rows
  optimisedFor  String[] // e.g. ["length_of_stay", "geographic_distribution"]
  createdAt     DateTime @default(now())
}

model Campaign {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  objective   String
  audience    String
  evidence    String
  message     String
  product     String
  channel     String
  cta         String
  measurement String

  status    String   @default("draft") // draft | needs_authorisation | approved | live
  createdAt DateTime @default(now())
}

// Scenario Engine answers — structured so FACT / EVIDENCE / INFERENCE /
// HYPOTHESIS / RECOMMENDATION are never collapsed into one undifferentiated blob.
model ScenarioQuery {
  id            String      @id @default(cuid())
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])

  question String
  askedBy  String

  facts            Json
  evidence         Json
  inferences       Json
  hypotheses       Json
  recommendations  Json
  insufficientData String[] // what's missing, if anything

  llmAssisted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ===========================================================================
// TOURISM AI GROWTH OS — operator pilot operating system
// See docs/GROWTH_OS.md for the design rationale. Everything below supports
// delivering the 12-week Tourism AI Growth Pilot; the destination-intelligence
// models above are retained as the foundation for the future Rotorua Pulse.
// ===========================================================================

// Display names live in src/lib/labels.ts. Default permissions per role
// live in src/lib/rbac/permissions.ts and can be overridden per role
// (RolePermission) and per user (UserPermission) by a super admin.
enum UserRole {
  FOUNDER // "Super Admin" — everything, always; cannot be restricted
  ADMIN // "Platform Staff" — programme delivery, business directory, audit
  PROGRAMME_MANAGER // "Programme Manager" — programme delivery
  ANALYST // "Read-only / Analyst" — reads programme data, changes nothing
  OPERATOR // "Tourism Operator" — own linked business(es) + cohort-shared content only
}

enum UserStatus {
  PENDING // invited; has not set a password yet
  ACTIVE
  SUSPENDED // temporarily blocked; can be reactivated
  ARCHIVED // deactivated
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum BusinessAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Who can see a record. Enforced server-side in src/lib/authz.ts.
enum Visibility {
  INTERNAL // programme staff only (founder notes, assessments in draft)
  CONFIDENTIAL // the owning operator + programme staff
  COHORT // shared with all participating operators
  AGGREGATE_APPROVED // approved for anonymised aggregate reporting
  PUBLIC_APPROVED // approved for public case studies
}

enum OperatorStatus {
  PROSPECT
  INVITED
  ONBOARDING
  ACTIVE
  PAUSED
  COMPLETED
  WITHDRAWN
}

enum WorkStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum Horizon {
  NOW
  NEXT
  LATER
  IGNORE
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// Distinguishes facts from claims from guesses (Module C).
enum EvidenceKind {
  OBSERVED // seen directly by programme staff (e.g. website review)
  OPERATOR_REPORTED // stated by the operator, not independently verified
  MEASURED // a recorded measurement / system export
  THIRD_PARTY // external published source
  HYPOTHESIS // an untested belief
}

enum SolutionType {
  AI_ASSISTED // uses an LLM / AI tool
  AUTOMATION // rules-based automation, no AI needed
  PROCESS_CHANGE // better process, no new tech
  WEBSITE_CONTENT // improve website / listing information
  TRAINING // skills / capability
  OTHER
}

enum OpportunityStatus {
  IDENTIFIED
  PRIORITISED
  APPROVED
  IN_PROGRESS
  LIVE
  MEASURING
  CLOSED
  REJECTED
}

enum Decision {
  SCALE
  AMEND
  STOP
  INVESTIGATE
}

enum AssessmentArea {
  AI_SEARCH_VISIBILITY
  MARKETING_CONTENT
  ENQUIRIES_CONVERSION
  BOOKING_JOURNEY
  GUEST_COMMUNICATIONS
  ADMIN_WORKLOAD
  REPORTING_DECISIONS
  OPERATIONS
  FEEDBACK_PRODUCT
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  COMPLETE
}

enum ExperimentStatus {
  DESIGN
  RUNNING
  ANALYSING
  COMPLETE
  ABANDONED
}

enum ComparisonMethod {
  BEFORE_AFTER
  CONTROL_GROUP
  MATCHED_COMPARISON
  NONE
}

enum MetricKey {
  QUALIFIED_ENQUIRIES
  BOOKING_CONVERSION
  BOOKING_VALUE
  ATTRIBUTABLE_REVENUE
  GUEST_NIGHTS
  TIME_SAVED_HOURS
  COST_PER_BOOKING
  AI_SEARCH_VISIBILITY
  REFERRAL_TRAFFIC
  GUEST_SATISFACTION
  TOTAL_BOOKINGS
  OTHER
}

enum MeasurementKind {
  BASELINE
  RESULT
}

enum CulturalReview {
  NOT_APPLICABLE
  REQUIRED // must be approved by an appropriate authority before sharing
  APPROVED
}

enum WorkflowKind {
  CONCEPT_SPEC // strategic concept / specification only
  PROMPT_TEMPLATE // a prompt a human runs manually
  AUTOMATED_WORKFLOW // scripted / no-code automation
  AGENT // a functioning agent with tools
}

enum WorkflowStatus {
  CONCEPT
  TESTING
  VALIDATED
  OPERATIONAL
  RETIRED
}

enum DealType {
  PARTICIPATION_FEE
  SPONSORSHIP
  IMPLEMENTATION
  RECURRING_SERVICE
  LICENSING
  OTHER
}

// Proposed, quoted and contracted are distinct stages; received money is
// recorded separately as Payment rows and is never inferred from a stage.
enum DealStage {
  OPPORTUNITY
  PROPOSED
  QUOTED
  CONTRACTED
  LOST
}

enum CostCategory {
  DELIVERY_LABOUR
  CONTRACTOR
  SOFTWARE
  TRAVEL
  VENUE
  OTHER
}

enum RiskKind {
  RISK
  BLOCKER
  ISSUE
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  role              UserRole
  passwordHash      String? // null until an invited user sets a password
  // OPERATOR users: the business they are currently working in. Must be one
  // of their memberships (UserBusiness); checked on every request.
  operatorId        String?
  operator          Operator?  @relation(fields: [operatorId], references: [id])
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions        AuthSession[]
  ownedOpps       Opportunity[]        @relation("OpportunityOwner")
  assignedTasks   Task[]               @relation("TaskAssignee")
  auditLogs       AuditLog[]
  businesses      UserBusiness[]
  permissions     UserPermission[]
  authTokens      AuthToken[]          @relation("TokenUser")
  issuedTokens    AuthToken[]          @relation("TokenIssuer")
  billingRecorded BillingTransaction[]
}

// Many-to-many link between users and businesses (Operator).
model UserBusiness {
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operatorId       String
  operator         Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  isPrimaryContact Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@id([userId, operatorId])
  @@index([operatorId])
}

// Per-role overrides of the code defaults in src/lib/rbac/permissions.ts.
// Ignored for FOUNDER (super admins always hold every permission).
model RolePermission {
  role        UserRole
  permission  String
  granted     Boolean
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([role, permission])
}

// Per-user grant/deny on top of the role's permissions.
model UserPermission {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  granted     Boolean
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([userId, permission])
}

// Single-use, time-limited tokens for invitations, password resets and
// email verification. Only a SHA-256 hash of the token is stored.
model AuthToken {
  id          String           @id @default(cuid())
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  userId      String
  user        User             @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?            @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, purpose])
}

// Server-side session: only a SHA-256 hash of the cookie token is stored.
model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Generic sliding-window counter for src/lib/rate-limit.ts. `key` is
// "<scope>:<identifier>", e.g. "login-ip:203.0.113.4" or
// "ai-discovery:usr_123" — one row per attempt, counted within a window.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // "create" | "update" | "delete" | "login" | "export" ...
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PROGRAMME (Module F) — dates derive from startDate + week numbers, so
// moving the start date reschedules everything.
// ---------------------------------------------------------------------------

model Programme {
  id          String   @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  totalWeeks  Int      @default(12)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages      ProgrammeStage[]
  milestones  Milestone[]
  operators   Operator[]
  workshops   Workshop[]
  initiatives SharedInitiative[]
}

model ProgrammeStage {
  id          String    @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  startWeek   Int
  endWeek     Int
  goals       String[]
}

model Milestone {
  id          String     @id @default(cuid())
  programmeId String
  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title       String
  week        Int
  status      WorkStatus @default(TODO)
  notes       String?
}

// ---------------------------------------------------------------------------
// OPERATORS (Module B)
// ---------------------------------------------------------------------------

model Operator {
  id          String         @id @default(cuid())
  programmeId String?
  programme   Programme?     @relation(fields: [programmeId], references: [id])
  name        String
  category    String // "accommodation" | "activity" | "attraction" | "cultural" | "food" | "transport" | "other"
  status      OperatorStatus @default(PROSPECT)
  isSynthetic Boolean        @default(false) // demo data flag — never mix with real reporting

  contactName  String?
  contactEmail String?
  contactPhone String?
  websiteUrl   String?
  bookingUrl   String?

  experiences       String?
  targetMarkets     String[]
  marketingChannels String[]
  bookingProcess    String?
  techStack         String[]
  objectives        String?
  challenges        String?
  aiMaturity        Int? // 1 (none) – 5 (embedded)
  seasonality       String?
  groupTags         String[] // e.g. "overnight-package", "needs-booking-help"
  internalNotes     String? // staff only

  // Governance / permissions (Section 7)
  agreedScope           String?
  dataAgreementSignedAt DateTime?
  consentCohortSharing  Boolean   @default(false)
  consentAggregate      Boolean   @default(false)
  consentCaseStudy      Boolean   @default(false)
  dataRetentionNotes    String?
  culturalGuidance      String? // who holds authority over cultural content; what must not go into AI tools

  // Platform account (Admin & Access Management)
  accountStatus BusinessAccountStatus @default(ACTIVE)
  cohort        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  assessments   Assessment[]
  opportunities Opportunity[]
  projects      Project[]
  tasks         Task[]
  experiments   Experiment[]
  measurements  Measurement[]
  attendance    WorkshopAttendance[]
  initiatives   InitiativeParticipant[]
  learnings     Learning[]
  workflowUses  WorkflowUsage[]
  deals         Deal[]
  costs         CostItem[]
  risks         Risk[]
  decisions     DecisionRecord[]
  signals       Signal[]
  integrations  IntegrationConnection[]
  briefs        GrowthBrief[]
  competitors   Competitor[]
  contentBriefs ContentBrief[]
  profile       OperatorProfile?
  members       UserBusiness[]
  features      BusinessFeature[]
  subscriptions Subscription[]
  invoices      Invoice[]
  billingTxns   BillingTransaction[]
  billingEvents BillingEvent[]
}

// Portal modules enabled for a business. Keys: src/lib/rbac/features.ts.
// A missing row means the feature's default applies.
model BusinessFeature {
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  feature     String
  enabled     Boolean
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([operatorId, feature])
}

// ---------------------------------------------------------------------------
// ASSESSMENT (Module C)
// ---------------------------------------------------------------------------

model Assessment {
  id                 String           @id @default(cuid())
  operatorId         String
  operator           Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  status             AssessmentStatus @default(NOT_STARTED)
  conductedBy        String?
  conductedAt        DateTime?
  summary            String?
  sharedWithOperator Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  areas         AssessmentAreaScore[]
  opportunities Opportunity[]
}

model AssessmentAreaScore {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  area         AssessmentArea
  score        Int? // 1 (weak) – 5 (strong) current capability
  observed     String? // what staff saw directly
  reported     String? // what the operator told us
  notes        String?

  @@unique([assessmentId, area])
}

// ---------------------------------------------------------------------------
// OPPORTUNITY & IMPLEMENTATION REGISTER (Module D)
// ---------------------------------------------------------------------------

model SolutionTemplate {
  id                 String         @id @default(cuid())
  name               String
  area               AssessmentArea
  solutionType       SolutionType
  description        String
  steps              String?
  typicalEffortHours Int?
  typicalOneOffNzd   Float?
  typicalMonthlyNzd  Float?
  tools              String[]
  successMetric      String?
  workflowAssetId    String?
  workflowAsset      WorkflowAsset? @relation(fields: [workflowAssetId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  opportunities Opportunity[]
}

model Opportunity {
  id           String            @id @default(cuid())
  operatorId   String? // null => shared initiative
  operator     Operator?         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  initiativeId String?
  initiative   SharedInitiative? @relation(fields: [initiativeId], references: [id])
  assessmentId String?
  assessment   Assessment?       @relation(fields: [assessmentId], references: [id])
  templateId   String?
  template     SolutionTemplate? @relation(fields: [templateId], references: [id])

  title            String
  area             AssessmentArea
  solutionType     SolutionType
  problem          String
  currentProcess   String?
  proposedSolution String
  expectedValue    String?
  expectedValueNzd Float? // annualised estimate, NZD excl. GST
  impactScore      Int               @default(3) // 1-5
  effortScore      Int               @default(3) // 1-5 (5 = most effort)
  effortHours      Int?
  oneOffCostNzd    Float?
  monthlyCostNzd   Float?
  dataRequirements String?
  risks            String?
  dependencies     String?
  tools            String[]
  successMetric    String?
  baselineMetric   String?
  targetMetric     String?
  actualResult     String?
  evidenceBasis    EvidenceKind      @default(HYPOTHESIS)
  confidence       ConfidenceLevel   @default(MEDIUM)
  horizon          Horizon           @default(NEXT)
  status           OpportunityStatus @default(IDENTIFIED)
  decision         Decision?
  decisionNotes    String?
  ownerId          String?
  owner            User?             @relation("OpportunityOwner", fields: [ownerId], references: [id])
  visibility       Visibility        @default(CONFIDENTIAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]
  experiments Experiment[]
  signals     Signal[]
}

model Project {
  id             String            @id @default(cuid())
  title          String
  description    String?
  operatorId     String?
  operator       Operator?         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity?      @relation(fields: [opportunityId], references: [id])
  initiativeId   String?
  initiative     SharedInitiative? @relation(fields: [initiativeId], references: [id])
  status         WorkStatus        @default(TODO)
  startDate      DateTime?
  dueDate        DateTime?
  tools          String[]
  oneOffCostNzd  Float?
  monthlyCostNzd Float?
  testingNotes   String?
  approvedBy     String? // who approved go-live (human approval record)
  approvedAt     DateTime?
  adoption       String? // "not started" | "partial" | "embedded" free text
  visibility     Visibility        @default(CONFIDENTIAL)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tasks Task[]
}

model Task {
  id               String            @id @default(cuid())
  title            String
  description      String?
  operatorId       String?
  operator         Operator?         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  initiativeId     String?
  initiative       SharedInitiative? @relation(fields: [initiativeId], references: [id])
  workshopId       String?
  workshop         Workshop?         @relation(fields: [workshopId], references: [id])
  assigneeId       String?
  assignee         User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  ownerLabel       String? // owner who is not a system user, e.g. "Operator: Jo"
  dueDate          DateTime?
  status           WorkStatus        @default(TODO)
  priority         Horizon           @default(NOW)
  visibility       Visibility        @default(CONFIDENTIAL)
  completedAt      DateTime?
  aiAssisted       Boolean           @default(false) // AI drafts/executes part of this task
  requiresApproval Boolean           @default(false) // a named human must approve before it goes live
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, dueDate])
}

// Generic evidence attached to any record (opportunity, experiment, project…)
model Evidence {
  id          String       @id @default(cuid())
  entityType  String // "opportunity" | "experiment" | "project" | "operator" | "initiative"
  entityId    String
  operatorId  String? // owning operator, for access control
  kind        EvidenceKind
  description String
  reference   String? // URL / file location / system export name — files live in existing storage
  recordedBy  String
  observedAt  DateTime?
  visibility  Visibility   @default(CONFIDENTIAL)
  createdAt   DateTime     @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// COLLECTIVE (Module E)
// ---------------------------------------------------------------------------

model Workshop {
  id          String     @id @default(cuid())
  programmeId String
  programme   Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title       String
  week        Int
  date        DateTime?
  location    String? // venue or video link
  agenda      String?
  notes       String?
  status      WorkStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  attendance WorkshopAttendance[]
  tasks      Task[]
  learnings  Learning[]
}

model WorkshopAttendance {
  id         String   @id @default(cuid())
  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  attended   Boolean  @default(false)
  engagement Int? // 1-5 staff-rated engagement
  notes      String?

  @@unique([workshopId, operatorId])
}

model Learning {
  id                 String            @id @default(cuid())
  title              String
  body               String
  topic              String?
  operatorId         String? // source operator, if any
  operator           Operator?         @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  workshopId         String?
  workshop           Workshop?         @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  initiativeId       String?
  initiative         SharedInitiative? @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  isReusableProcess  Boolean           @default(false)
  visibility         Visibility        @default(INTERNAL)
  culturalReview     CulturalReview    @default(NOT_APPLICABLE)
  culturalApprovedBy String?
  createdBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Resource {
  id             String         @id @default(cuid())
  title          String
  description    String?
  url            String? // link to existing storage (Drive, Notion…) — no file hosting in phase 1
  resourceType   String // "template" | "guide" | "recording" | "slides" | "checklist"
  visibility     Visibility     @default(COHORT)
  culturalReview CulturalReview @default(NOT_APPLICABLE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model SharedInitiative {
  id                String     @id @default(cuid())
  programmeId       String?
  programme         Programme? @relation(fields: [programmeId], references: [id])
  title             String
  description       String
  initiativeType    String // "overnight-package" | "co-marketing" | "shared-content" | "stay-another-night" ...
  status            WorkStatus @default(TODO)
  attributionMethod String? // how bookings are attributed between partners
  results           String?
  visibility        Visibility @default(CONFIDENTIAL) // CONFIDENTIAL here = participants + staff
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  participants  InitiativeParticipant[]
  opportunities Opportunity[]
  projects      Project[]
  tasks         Task[]
  experiments   Experiment[]
  learnings     Learning[]
}

model InitiativeParticipant {
  id                   String           @id @default(cuid())
  initiativeId         String
  initiative           SharedInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  operatorId           String
  operator             Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  role                 String? // "accommodation partner" | "activity partner" | "lead"
  responsibilities     String?
  attributedBookings   Int?
  attributedRevenueNzd Float?
  consentConfirmed     Boolean          @default(false)

  @@unique([initiativeId, operatorId])
}

// ---------------------------------------------------------------------------
// EXPERIMENTS & MEASUREMENT (Module G)
// ---------------------------------------------------------------------------

model Experiment {
  id                 String            @id @default(cuid())
  title              String
  operatorId         String?
  operator           Operator?         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  initiativeId       String?
  initiative         SharedInitiative? @relation(fields: [initiativeId], references: [id])
  opportunityId      String?
  opportunity        Opportunity?      @relation(fields: [opportunityId], references: [id])
  isDestinationLevel Boolean           @default(false)

  hypothesis             String
  problem                String
  audience               String?
  intervention           String
  startDate              DateTime?
  endDate                DateTime?
  baselineStart          DateTime?
  baselineEnd            DateTime?
  comparisonMethod       ComparisonMethod @default(BEFORE_AFTER)
  primaryMetric          MetricKey
  primaryMetricLabel     String?
  secondaryMetrics       String[]
  baselineValue          Float?
  targetValue            Float?
  minimumAcceptable      Float?
  higherIsBetter         Boolean          @default(true)
  maxCostNzd             Float?
  actualValue            Float?
  actualCostNzd          Float?
  controlValue           Float? // control/matched group result, if used
  resultSummary          String?
  limitations            String?
  attributionNotes       String?
  // Destination-level outcomes, kept distinct (never collapsed into "impact")
  incrementalVisitors    Float?
  incrementalGuestNights Float?
  incrementalSpendNzd    Float?
  isIllustrative         Boolean          @default(false) // synthetic demo values
  status                 ExperimentStatus @default(DESIGN)
  supersedesId           String? // a re-run must say what is different from the earlier experiment
  changeFromPrevious     String?
  decision               Decision?
  nextAction             String?
  visibility             Visibility       @default(CONFIDENTIAL)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  measurements Measurement[]
}

model Measurement {
  id             String          @id @default(cuid())
  operatorId     String?
  operator       Operator?       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  experimentId   String?
  experiment     Experiment?     @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  metric         MetricKey
  label          String? // for OTHER or a more specific description
  kind           MeasurementKind
  value          Float
  unit           String
  periodStart    DateTime
  periodEnd      DateTime
  source         String // where the number came from, e.g. "Rezdy export", "GA4", "operator estimate"
  evidenceKind   EvidenceKind    @default(OPERATOR_REPORTED)
  isIllustrative Boolean         @default(false) // synthetic / demo value — labelled everywhere
  notes          String?
  recordedBy     String
  createdAt      DateTime        @default(now())

  @@index([operatorId, metric])
}

// ---------------------------------------------------------------------------
// GOVERNANCE OF THE PROGRAMME: risks + decisions (Modules A/H)
// ---------------------------------------------------------------------------

model Risk {
  id         String     @id @default(cuid())
  kind       RiskKind   @default(RISK)
  title      String
  detail     String?
  severity   Severity   @default(MEDIUM)
  operatorId String?
  operator   Operator?  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  owner      String?
  mitigation String?
  status     WorkStatus @default(TODO)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// Report-style decision record: what changed / evidence / why it matters /
// next step / owner / review date.
model DecisionRecord {
  id           String     @id @default(cuid())
  title        String
  whatChanged  String
  evidence     String?
  whyItMatters String?
  nextAction   String?
  owner        String?
  reviewDate   DateTime?
  operatorId   String?
  operator     Operator?  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  decided      Boolean    @default(false)
  outcome      String?
  visibility   Visibility @default(INTERNAL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// AI AGENT & WORKFLOW LIBRARY (Module I)
// ---------------------------------------------------------------------------

model WorkflowAsset {
  id                  String         @id @default(cuid())
  name                String
  kind                WorkflowKind
  status              WorkflowStatus @default(CONCEPT)
  purpose             String
  problem             String?
  intendedUser        String?
  inputs              String?
  expectedOutput      String?
  tools               String[]
  permissions         String?
  humanApproval       String? // what must a human approve before output is used
  costNotes           String?
  limitations         String?
  testResults         String?
  evidenceOfValue     String?
  culturalReview      CulturalReview @default(NOT_APPLICABLE)
  strategicInitiative String? // e.g. "Rotorua First Answer"
  currentVersion      Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  versions  WorkflowVersion[]
  usages    WorkflowUsage[]
  templates SolutionTemplate[]
}

model WorkflowVersion {
  id           String        @id @default(cuid())
  assetId      String
  asset        WorkflowAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      Int
  instructions String // the prompt / workflow definition / spec
  changeNote   String?
  createdBy    String
  createdAt    DateTime      @default(now())

  @@unique([assetId, version])
}

model WorkflowUsage {
  id         String        @id @default(cuid())
  assetId    String
  asset      WorkflowAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  operatorId String
  operator   Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  status     String        @default("piloting") // piloting | in use | stopped
  notes      String?
  createdAt  DateTime      @default(now())

  @@unique([assetId, operatorId])
}

// ---------------------------------------------------------------------------
// COMMERCIAL (Module J) — NZD excl. GST. Planning, not accounting.
// ---------------------------------------------------------------------------

model Deal {
  id                String    @id @default(cuid())
  title             String
  organisation      String
  operatorId        String?
  operator          Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  type              DealType
  stage             DealStage @default(OPPORTUNITY)
  oneOffValueNzd    Float     @default(0)
  monthlyValueNzd   Float     @default(0)
  termMonths        Int       @default(0)
  probability       Int       @default(25) // % — used for weighted forecast only
  expectedCloseDate DateTime?
  contractSignedAt  DateTime?
  renewalDate       DateTime?
  isIllustrative    Boolean   @default(false) // demo figure — labelled everywhere
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments Payment[]
  costs    CostItem[]
}

model Payment {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amountNzd  Float
  receivedAt DateTime
  reference  String?
  createdAt  DateTime @default(now())
}

model CostItem {
  id             String       @id @default(cuid())
  description    String
  category       CostCategory
  amountNzd      Float
  incurredAt     DateTime
  isMonthly      Boolean      @default(false) // recurring monthly cost (e.g. software)
  isForecast     Boolean      @default(false) // planned, not yet incurred
  isIllustrative Boolean      @default(false)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  operatorId     String?
  operator       Operator?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
}

model PricingScenario {
  id                       String   @id @default(cuid())
  name                     String
  cohortSize               Int
  feePerOperatorNzd        Float
  sponsorshipNzd           Float    @default(0)
  implementationAttachRate Float    @default(0) // 0-1
  implementationAvgNzd     Float    @default(0)
  recurringAttachRate      Float    @default(0) // 0-1
  recurringMonthlyNzd      Float    @default(0)
  recurringMonths          Int      @default(12)
  deliveryHoursPerOperator Float    @default(0)
  sharedDeliveryHours      Float    @default(0) // workshops, programme mgmt
  hourlyCostNzd            Float    @default(0)
  softwareMonthlyNzd       Float    @default(0)
  programmeMonths          Int      @default(3)
  otherFixedCostsNzd       Float    @default(0)
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// OPERATOR GROWTH INTELLIGENCE — absorbed from the Tourism Growth
// Intelligence prototype (anigemmill/tourism-growth-agent). Signals are the
// atomic unit of evidence; briefs are persisted, human-approved snapshots
// built only from stored data.
// ---------------------------------------------------------------------------

enum ClaimType {
  FACT
  OBSERVATION
  INFERENCE
  HYPOTHESIS
  RECOMMENDATION
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  MANUAL_IMPORT
  REQUIRES_API
  REQUIRES_USER_AUTH
}

enum BriefStatus {
  DRAFT
  APPROVED
  SHARED // visible to the operator in their portal
}

model Signal {
  id                  String          @id @default(cuid())
  operatorId          String
  operator            Operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  type                String // DEMAND | REVIEW | ENQUIRY | AI_DISCOVERY | COMPETITOR | MARKET | OPERATIONS
  title               String
  summary             String
  claimType           ClaimType
  source              String // human-readable source; "Operator" when submitted via the portal
  sourceTimestamp     DateTime
  evidence            String?
  confidence          ConfidenceLevel @default(MEDIUM)
  momentum            String? // DECLINING | STABLE | RISING
  commercialPotential String? // LOW | MEDIUM | HIGH
  submittedByOperator Boolean         @default(false)
  isIllustrative      Boolean         @default(false)
  visibility          Visibility      @default(CONFIDENTIAL)
  createdBy           String
  createdAt           DateTime        @default(now())

  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id])

  opportunities Opportunity[]

  @@index([operatorId, createdAt])
}

model IntegrationConnection {
  id           String            @id @default(cuid())
  operatorId   String
  operator     Operator          @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  sourceKey    String // src/lib/integrations/registry.ts key
  status       IntegrationStatus
  notes        String? // non-secret notes only — never store tokens here
  lastSyncedAt DateTime?
  updatedAt    DateTime          @updatedAt

  @@unique([operatorId, sourceKey])
}

model GrowthBrief {
  id           String      @id @default(cuid())
  operatorId   String
  operator     Operator    @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  weekOf       DateTime
  whatChanged  Json // [{ text, claimType, source, signalId? }]
  whyItMatters String?
  actions      Json // [{ action, why, owner, effort, measure, needsApproval }]
  learnings    String? // LEARN: what last period's actions showed (or could not show)
  dataGaps     String[]
  generatedBy  String // "rules" | "rules+llm"
  status       BriefStatus @default(DRAFT)
  approvedBy   String?
  approvedAt   DateTime?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([operatorId, weekOf])
}

// ---------------------------------------------------------------------------
// Operator Growth Intelligence — additional modules ported from TGI
// (content briefs, competitor tracking, LLM website analysis). See
// docs/GROWTH_OS.md §5.4 for what these add to the original absorption.
// ---------------------------------------------------------------------------

model Competitor {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  name       String
  websiteUrl String?
  notes      String?
  createdBy  String
  createdAt  DateTime @default(now())

  signals Signal[]

  @@index([operatorId])
}

model ContentBrief {
  id               String             @id @default(cuid())
  operatorId       String
  operator         Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  contentType      ContentType
  title            String
  whyNow           String // traveller demand / commercial intent / SEO / AI discovery / competitive gap — never "just because it's trending"
  targetAudience   String
  keyPoints        String[]
  seoNotes         String?
  aiDiscoveryNotes String?
  status           ContentBriefStatus @default(PROPOSED)
  approvedBy       String?
  approvedAt       DateTime?
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([operatorId, status])
}

/// LLM-derived site profile (1:1, optional). Never populated without a
/// configured ANTHROPIC_API_KEY; analysisStatus reflects the honest state.
model OperatorProfile {
  id                    String           @id @default(cuid())
  operatorId            String           @unique
  operator              Operator         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  positioning           String?
  differentiators       String[]
  pricingSummary        String?
  experiencesSummary    String?
  seasonalitySummary    String?
  faqs                  Json? // [{ question, answer }]
  bookingProcessSummary String?
  currentContentSummary String?
  analysisStatus        String           @default("NOT_CONNECTED") // CONNECTED | REQUIRES_API | FAILED | NOT_CONNECTED
  analysisError         String?
  analysisConfidence    ConfidenceLevel?
  analyzedAt            DateTime?
  analyzedBy            String?
  updatedAt             DateTime         @updatedAt
}

enum ContentType {
  LANDING_PAGE
  BLOG
  DESTINATION_GUIDE
  FAQ
  SOCIAL_POST
  VIDEO
  EMAIL
  PR
  COMPARISON
  ITINERARY
}

enum ContentBriefStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  PUBLISHED
  REJECTED
}

// ===========================================================================
// BILLING — see docs/BILLING.md. No payment provider is integrated yet: every
// record created in the app is source MANUAL and is labelled as manually
// recorded. PROVIDER records may only be written by a verified provider
// integration. No card numbers or payment credentials are ever stored.
// Amounts are integer minor units (cents).
// ===========================================================================

enum BillingSource {
  MANUAL // entered by an administrator — not confirmed by a payment provider
  PROVIDER // confirmed by a payment provider (webhook / API) — not settable in the UI
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_OFF
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum BillingTxnKind {
  PAYMENT // money received
  REFUND // money returned
  CREDIT // adjustment reducing what is owed
  CHARGE // adjustment increasing what is owed
}

enum BillingTxnStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Subscription {
  id                      String             @id @default(cuid())
  operatorId              String
  operator                Operator           @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  plan                    String
  status                  SubscriptionStatus @default(ACTIVE)
  interval                BillingInterval    @default(MONTHLY)
  amountCents             Int
  currency                String             @default("NZD")
  currentPeriodStart      DateTime?
  renewalDate             DateTime?
  cancelledAt             DateTime?
  source                  BillingSource      @default(MANUAL)
  providerCustomerRef     String?
  providerSubscriptionRef String?
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  invoices Invoice[]

  @@index([operatorId])
}

model Invoice {
  id             String        @id @default(cuid())
  operatorId     String
  operator       Operator      @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String        @unique
  status         InvoiceStatus @default(OPEN)
  amountCents    Int
  currency       String        @default("NZD")
  issuedAt       DateTime
  dueAt          DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  source         BillingSource @default(MANUAL)
  providerRef    String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  transactions BillingTransaction[]

  @@index([operatorId])
  @@index([status])
}

model BillingTransaction {
  id                     String           @id @default(cuid())
  operatorId             String
  operator               Operator         @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  invoiceId              String?
  invoice                Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  kind                   BillingTxnKind
  status                 BillingTxnStatus
  amountCents            Int // always positive; kind gives the direction
  currency               String           @default("NZD")
  occurredAt             DateTime
  source                 BillingSource    @default(MANUAL)
  method                 String? // e.g. "bank transfer" — never card details
  providerTransactionRef String?
  failureReason          String?
  note                   String?
  recordedById           String?
  recordedBy             User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt              DateTime         @default(now())

  @@index([operatorId, occurredAt])
  @@index([status])
}

// Timeline of billing changes and admin notes for a business.
model BillingEvent {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  type       String // "note" | "subscription.created" | "invoice.created" | "transaction.recorded" ...
  summary    String
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([operatorId, createdAt])
}
